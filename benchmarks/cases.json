      "expected": "{data}/mix_reads.out_expected.gtf"
    },
    {
      "name": "mixed_reads_guided",
      "args": ["--mix", "-G", "{data}/mix_guides.gff", "-o", "{output}", "{data}/mix_short.bam", "{data}/mix_long.bam"],
      "expected": "{data}/mix_reads_guided.out_expected.gtf"
    },
    {
      "name": "short_reads_N_guided",
      "args": ["-N", "-G", "{data}/mix_guides.gff", "-o", "{output}", "{data}/mix_short.bam"],
      "expected": "{data}/mix_short_N_guided.out_expected.gtf"
    },
    {
      "name": "short_reads_nascent_guided",
      "args": ["--nasc", "-G", "{data}/mix_guides.gff", "-o", "{output}", "{data}/mix_short.bam"],
      "expected": "{data}/mix_short_nasc_guided.out_expected.gtf"
    }
  ]
