      "expected": "{data}/short_guided.out_expected.gtf"
    },
    {
      "name": "long_reads",
      "args": ["-L", "-o", "{output}", "{data}/long_reads.bam"],
      "expected": "{data}/long_reads.out_expected.gtf"
    },
    {
      "name": "long_reads_guided",
