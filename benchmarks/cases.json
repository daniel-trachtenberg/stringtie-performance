    },
    {
      "name": "short_reads_and_superreads",
      "args": ["-o", "{output}", "{data}/short_reads_and_superreads.bam"],
      "expected": "{data}/short_reads_and_superreads.out_expected.gtf"
    },
    {
      "name": "short_guided",
